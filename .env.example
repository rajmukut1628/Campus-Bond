# Copy to .env in the project root. Use a replica set or MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/university_connect?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
# Explicit bootstrap credentials, required only for npm run seed:
SEED_ADMIN_EMAIL=owner@example.edu
SEED_ADMIN_ID=OWNER001
SEED_ADMIN_NAME=University Owner
SEED_ADMIN_PASSWORD=replace-with-a-unique-password

# Optional Gmail email delivery. Keep SMTP_PASS private; never use a VITE_ variable.
# You may put these in .env.mail in the project root instead (recommended locally).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=NUB Connect
# Optional absolute path if the private mail file is stored elsewhere:
# MAIL_CONFIG_PATH=C:/private/university-connect.env.mail
